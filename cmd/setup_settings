#!/bin/bash

link_files() {
  local label=$1
  local src=$2
  local dest=$3

  echo "--- $label ---"
  mkdir -p "$dest"
  for f in $(ls -A "$src")
  do
    echo $f
    ln -f "$src/$f" "$dest/$f"
  done
}

echo 'Create links'
DIRS=(asdf terminal vim zsh ruby tmux)
DOT_HOME=$HOME/dotfiles
for dir in ${DIRS[@]}
do
  link_files "$dir" "$DOT_HOME/$dir" "$HOME"
done

XDG_CONFIG_BASE="${XDG_CONFIG_HOME:-$HOME/.config}"
link_files "herdr" "$DOT_HOME/herdr" "$XDG_CONFIG_BASE/herdr"

if [ "$(uname -s)" = "Linux" ]; then
  link_files "ghostty" "$DOT_HOME/ghostty" "$XDG_CONFIG_BASE/ghostty"
fi
