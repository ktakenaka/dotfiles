# Font
font-family = Monaco
font-size = 12

# Colors (Solarized Dark)
background = 1a1a1a
foreground = e3ddd6

# Transparency & blur
background-opacity = 0.75
background-blur-radius = 10

# Cursor (iTerm2 type 2 = underline)
cursor-style = underline
cursor-color = 839496
cursor-text = 073642

# Selection
selection-background = cccccc
selection-foreground = 93a1a1

# Scrollback
scrollback-limit = 20000

# Fullscreen (iTerm2 Window Type 1)
fullscreen = true

# Initial window size (columns x rows)
window-width = 80
window-height = 100

# Option key sends ESC sequences (Meta)
macos-option-as-alt = true

# ANSI color palette
palette = 0=#073642
palette = 1=#dc322f
palette = 2=#859900
palette = 3=#b58900
palette = 4=#268bd2
palette = 5=#d33682
palette = 6=#2aa198
palette = 7=#eee8d5
palette = 8=#002b36
palette = 9=#cb4b16
palette = 10=#586e75
palette = 11=#657b83
palette = 12=#839496
palette = 13=#6c71c4
palette = 14=#93a1a1
